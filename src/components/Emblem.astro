---
import { coffeeMark, gearPath } from '../utils/illustrations';

interface Props {
  size?: number;
  /** Simplified mark for small sizes (logomark, favicon). */
  simple?: boolean;
}
const { size = 180, simple = false } = Astro.props;
const gear = gearPath(simple ? 12 : 16, 92, 78);
---

<svg class="emblem" viewBox="0 0 200 200" width={size} height={size} aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round">
    <path d={gear} />
    {!simple && <circle cx="100" cy="100" r="72" />}
    <path d={coffeeMark.saucer} />
    <path d={coffeeMark.handle} />
    <path d={coffeeMark.cup} fill="var(--paper)" />
    <path d={coffeeMark.steam} />
    <path d={coffeeMark.link} stroke-width="1" />
    {coffeeMark.nodes.map(([x, y]) => <circle cx={x} cy={y} r="3.4" fill="var(--paper)" />)}
    <path d={coffeeMark.face} stroke-width="1.25" />
    {coffeeMark.eyes.map(([x, y]) => <circle cx={x} cy={y} r="2.6" fill="currentColor" stroke="none" />)}
  </g>
</svg>
