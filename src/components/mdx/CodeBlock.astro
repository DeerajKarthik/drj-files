---
// Replaces <pre> in rendered Markdown (see components map). Shiki supplies the highlighted <code>.
const { 'data-title': title, 'data-lang': lang, class: className, ...rest } = Astro.props as Record<string, string | undefined>;
---

<figure class="codeblock" data-codeblock>
  <figcaption class="codeblock-head">
    <span class="codeblock-title trim">{title ?? lang ?? 'code'}</span>
    {title && lang && <span class="codeblock-lang tag trim">{lang}</span>}
    <button class="codeblock-copy js-only" type="button" data-copy-code aria-label={`Copy code${title ? ` from ${title}` : ''}`}>
      <span class="label trim" data-copy-label>Copy</span>
    </button>
    <span class="visually-hidden" role="status" aria-live="polite" data-copy-status></span>
  </figcaption>
  <pre class={className} {...rest}><slot /></pre>
</figure>

<script>
  import '../../scripts/copy';
</script>
