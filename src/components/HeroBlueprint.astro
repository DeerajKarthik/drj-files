---
// Side elevation of a coffee-fuelled thruster, exploded along a horizontal axis:
// cup -> intake ring -> stabiliser -> core -> nozzle, exhausting coffee beans.
const AXIS = 104;
const r1 = (n: number): number => Math.round(n * 10) / 10;
const tau = Math.PI * 2;

/** Point on an upright ellipse centred (cx, AXIS). */
const onEllipse = (cx: number, rx: number, ry: number, a: number): string =>
  `${r1(cx + rx * Math.cos(a))} ${r1(AXIS + ry * Math.sin(a))}`;

/** Teeth around the intake ring. */
let teeth = '';
for (let i = 0; i < 22; i++) {
  const a = (i / 22) * tau;
  teeth += `M${onEllipse(96, 9, 46, a)}L${onEllipse(96, 12.5, 51, a)}`;
}

/** Spokes between the stabiliser's hub and rim. */
let spokes = '';
for (let i = 0; i < 9; i++) {
  const a = (i / 9) * tau + 0.3;
  spokes += `M${onEllipse(146, 3.5, 9, a)}L${onEllipse(146, 10, 36, a)}`;
}

/** Coil bands along the core. */
let bands = '';
for (let x = 203; x < 232; x += 5) bands += `M${x} ${AXIS - 31}V${AXIS + 31}`;

/** Exhaust hatch behind the nozzle. */
const exhaust = 'M316 92H336M316 104H350M316 116H336M316 84H328M316 124H328';

const bean = (x: number, y: number, rot: number): string =>
  `translate(${x} ${y}) rotate(${rot})`;
---

<span class="illus hero-illus">
  <svg viewBox="0 0 360 210" width="360" height="210" aria-hidden="true" focusable="false">
    <g class="ink">
      <!-- centre line and exploded rim lines -->
      <path class="thin" d={`M6 ${AXIS}H354`} stroke-dasharray="8 3 1 3" />
      <path class="thin" d="M96 58L146 66L196 72M96 150L146 142L196 136M232 72L252 84M232 136L252 124" stroke-dasharray="2 3" />

      <!-- B: stabiliser -->
      <ellipse class="fill" cx="146" cy={AXIS} rx="11" ry="38" />
      <ellipse cx="146" cy={AXIS} rx="3.5" ry="9" />
      <path class="hatch" d={spokes} />

      <!-- A: intake ring -->
      <path class="hatch" d={teeth} />
      <ellipse class="fill" cx="96" cy={AXIS} rx="9" ry="46" />
      <ellipse cx="96" cy={AXIS} rx="4.5" ry="30" />
      <ellipse class="fill alt" cx="96" cy={AXIS} rx="2" ry="9" />

      <!-- C: core cylinder with a porthole -->
      <path class="fill" d={`M200 ${AXIS - 32}H232V${AXIS + 32}H200Z`} />
      <path class="hatch" d={bands} />
      <ellipse class="fill" cx="200" cy={AXIS} rx="7" ry="32" />
      <ellipse class="fill" cx="232" cy={AXIS} rx="7" ry="32" />
      <circle class="fill alt" cx="216" cy={AXIS} r="9" />
      <circle cx="216" cy={AXIS} r="3.2" />

      <!-- D: bell nozzle -->
      <path class="fill" d={`M252 ${AXIS - 20}C272 ${AXIS - 20} 288 ${AXIS - 38} 304 ${AXIS - 48}L304 ${AXIS + 48}C288 ${AXIS + 38} 272 ${AXIS + 20} 252 ${AXIS + 20}Z`} />
      <path class="hatch" d={`M262 ${AXIS - 18}L262 ${AXIS + 18}M272 ${AXIS - 21}L272 ${AXIS + 21}M282 ${AXIS - 27}L282 ${AXIS + 27}M292 ${AXIS - 34}L292 ${AXIS + 34}`} />
      <ellipse class="fill alt" cx="304" cy={AXIS} rx="7" ry="48" />
      <ellipse cx="304" cy={AXIS} rx="3" ry="30" />

      <!-- exhaust: coffee beans -->
      <path class="hatch" d={exhaust} />
      <g transform={bean(334, 74, -25)}><ellipse class="fill" rx="6" ry="3.6" /><path d="M-5 0C-2 -2 2 2 5 0" class="thin" /></g>
      <g transform={bean(346, 134, 20)}><ellipse class="fill" rx="6" ry="3.6" /><path d="M-5 0C-2 -2 2 2 5 0" class="thin" /></g>
      <g transform={bean(352, 104, 0)}><ellipse class="fill" rx="5" ry="3" /><path d="M-4 0C-2 -1.6 2 1.6 4 0" class="thin" /></g>

      <!-- fuel: a floating cup, feeding the intake -->
      <path class="fill" d="M14 62H44C44 76 40 82 29 82C18 82 14 76 14 62Z" />
      <path d="M44 65C53 64 53 75 43 74" />
      <circle cx="24" cy="72" r="1" /><circle cx="33" cy="72" r="1" />
      <path class="thin" d="M21 55C18 52 24 50 21 46M29 55C26 52 32 50 29 46M37 55C34 52 40 50 37 46" />
      <path class="thin" d="M30 84C34 96 60 100 82 103" stroke-dasharray="2 3" />

      <!-- balloons -->
      <path class="thin" d="M96 43V30M146 63V30M216 68V30M278 62V30" />
      <circle class="fill" cx="96" cy="23" r="7" /><text class="balloon" x="96" y="26" text-anchor="middle">A</text>
      <circle class="fill" cx="146" cy="23" r="7" /><text class="balloon" x="146" y="26" text-anchor="middle">B</text>
      <circle class="fill" cx="216" cy="23" r="7" /><text class="balloon" x="216" y="26" text-anchor="middle">C</text>
      <circle class="fill" cx="278" cy="23" r="7" /><text class="balloon" x="278" y="26" text-anchor="middle">D</text>

      <!-- baseline dimension: exactly aligned with part centres -->
      <path class="thin" d="M96 168H304M96 160V176M146 160V176M216 160V176M304 160V176" />
    </g>

    <g class="annot">
      <path class="dash" d="M216 70V138" />
      <path class="strong" d="M216 70l-4 8h8ZM216 138l-4-8h8Z" />
      <path class="dim" d="M96 182H304M96 177v10M304 177v10M146 177v10M216 177v10" />
      <path class="dim" d="M312 78V130M308 78h8M308 130h8" />
      <path class="strong" d="M316 104H354M354 104l-6-3M354 104l-6 3" />
      <path class="dash" d="M96 58V152M146 66V142M304 56V152" />
      <text class="callout" x="121" y="195" text-anchor="middle">50</text>
      <text class="callout" x="181" y="195" text-anchor="middle">70</text>
      <text class="callout" x="260" y="195" text-anchor="middle">88</text>
      <text class="callout" x="182" y="206" text-anchor="middle">L 208</text>
      <text class="callout" x="36" y="96" text-anchor="middle">FUEL</text>
      <text class="callout" x="224" y="68">C–C</text>
      <text class="callout" x="322" y="146">Ø 96</text>
      <text class="callout" x="322" y="68">THRUST →</text>
      <text class="callout" x="154" y="56">8 SPOKES</text>
    </g>
  </svg>
  <span class="stencil" aria-hidden="true">NB-2027</span>
</span>
